{
  "name": "prompt-coach",
  "version": "0.1.0",
  "private": true,
  "description": "A Claude Code mod that coaches your English while you write prompts",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "claude plugin validate .",
    "test": "claude plugin test .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm validate && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
